# --- Database (Azure SQL in prod; local SQL Server container in dev) ---
DATABASE_URL="sqlserver://localhost:1433;database=hrapp;user=sa;password=YourStrong!Passw0rd;trustServerCertificate=true"

# --- Email sending ---
# mock  = log each "send" to the console, no network calls, no credentials needed
# graph = send via Microsoft Graph as the shared mailbox below (requires the four AZURE_* vars)
EMAIL_MODE="mock"
MAIL_SENDER_ADDRESS="hr@standardnutrition.com"

# Required only when EMAIL_MODE=graph. Entra app registration with an
# application-level Mail.Send permission, granted admin consent.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# --- Links ---
# Base URL employees hit their unique link against, e.g. https://physicals.standardnutrition.com
APP_BASE_URL="http://localhost:3000"

# Days an employee's upload/download link stays valid after being sent
TOKEN_EXPIRY_DAYS="30"

# --- Employee-facing web server ---
PORT="3000"

# --- Uploaded form storage (Blob Storage in prod; Azurite emulator in dev) ---
# The value below is Azurite's well-known, publicly-documented dev account key
# (not a secret) — safe to keep as the default for local development.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
UPLOADS_CONTAINER_NAME="uploaded-forms"
MAX_UPLOAD_MB="20"

# --- HR dashboard auth ---
# mock  = a "Dev Sign-In" button with no real credential check. Local dev only —
#         the app refuses to start this way when NODE_ENV=production.
# entra = real Microsoft Entra ID SSO via the four ENTRA_* vars below.
AUTH_MODE="mock"
NODE_ENV="development"

# Any random string — used to sign the HR dashboard's session cookie.
SESSION_SECRET="change-me-to-a-random-string"

# Required only when AUTH_MODE=entra. A separate app registration from the
# Graph-sending one above is fine (different permission type: delegated
# sign-in vs. application Mail.Send) — or reuse the same registration if it's
# configured with both.
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
ENTRA_REDIRECT_URI="http://localhost:3000/auth/callback"

# Optional: an Entra security group's object ID. If set, only members of this
# group can sign in to the dashboard (requires the app registration to emit a
# "groups" claim). If unset, any authenticated tenant user can sign in.
HR_GROUP_OBJECT_ID=""
