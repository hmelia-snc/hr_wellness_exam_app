generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// Prisma's sqlserver connector has no native enum support, so `status` is a
// plain String constrained at the application layer (see src/lib/status.ts)
// rather than a Prisma enum.
model Employee {
  id                  String   @id @default(uuid())
  fullName            String
  // Nullable so a spouse row (see recordType below) can be added without an
  // email of its own — the spouse never gets independent link/email
  // delivery, so there's nothing to send one to. Unlike Postgres, SQL
  // Server's default unique constraint only allows ONE NULL, so this column
  // is backed by a *filtered* unique index instead (see the
  // unique_linked_employee_id migration) — that's what actually lets
  // multiple email-less spouse rows coexist alongside real, unique employee
  // emails, not this @unique attribute on its own. That filter also excludes
  // recordType="spouse" rows entirely (see the
  // spouse_email_not_unique migration): a spouse commonly shares its linked
  // employee's email (a household inbox), which is fine since a spouse never
  // gets independent link/email delivery — only two "employee" rows sharing
  // an email is actually a problem. Because of that filter, a plain
  // `prisma.employee.upsert({ where: { email } })`/`findUnique` is unsafe —
  // it could match a same-email spouse row instead of the real employee —
  // so employeeActions.ts looks employees up by `findFirst({ where: { email,
  // recordType: "employee" } })` instead.
  email               String?  @unique
  employeeIdExternal  String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  // "employee" (default) or "spouse". A spouse is its own roster line — its
  // own dashboard row, its own PhysicalRecord per cycle, reviewed with the
  // same Approve/Reject actions as anyone else. Still submitted through the
  // employee's existing upload link, though: no separate email/login for
  // the spouse, just its own tracking record underneath.
  recordType          String     @default("employee")
  // Set only on a recordType="spouse" row: which employee it belongs to.
  // @unique caps it at one spouse row per employee — multiple NULLs (every
  // ordinary employee row) are still fine, same nullable-unique reasoning
  // as email above.
  linkedEmployeeId    String?    @unique
  linkedEmployee      Employee?  @relation("EmployeeSpouse", fields: [linkedEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  spouseRecords       Employee[] @relation("EmployeeSpouse")

  physicalRecords PhysicalRecord[]

  @@map("employees")
}

model PhysicalRecord {
  id                 String    @id @default(uuid())
  employeeId         String
  cycleYear          Int
  tokenHash          String    @unique
  // Plain-text copy of the same token tokenHash is derived from, so HR's
  // "Get Link" action can show the employee's existing link back to them
  // instead of generating (and thereby invalidating) a new one. Null for
  // records created before this field existed, or after resendLink
  // regenerates the token without also going through the reset helper below
  // — resolved by falling back to a fresh token in that case too.
  rawToken           String?
  tokenExpiresAt     DateTime
  status             String    @default("sent")
  sentAt             DateTime?
  receivedAt         DateTime?
  completedAt        DateTime?
  uploadedFileUrl    String?
  uploadedBlobPath   String?
  uploadedContentType String?
  verificationResult String?
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, cycleYear])
  @@map("physical_records")
}

model UploadBatch {
  id         String   @id @default(uuid())
  uploadedBy String
  uploadedAt DateTime @default(now())
  rowCount   Int

  @@map("upload_batches")
}

// Deliberately not FK-related to PhysicalRecord: an audit trail should
// survive even if the underlying record is later purged (see
// employeeActions.deleteEmployee), so a deleted employee's access history
// isn't silently destroyed along with it.
model FileAccessLog {
  id               String   @id @default(uuid())
  physicalRecordId String
  fileType         String // "employee" (only value recorded going forward)
  viewedBy         String // email of the HR user, or the employee's own email via their token
  viewedAt         DateTime @default(now())

  @@map("file_access_logs")
}
